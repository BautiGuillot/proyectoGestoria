---
// src/components/ui/BlogArticle.astro
import { Calendar, Clock } from "@lucide/astro";
import { formatDate, getReadingTime } from "../../utils/format";

const { post, index } = Astro.props;
---

<article
  class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 opacity-0 translate-y-8"
  data-anim="fade-in-up"
  style={`animation-delay: ${index * 100}ms`}
>
  <a href={`/blog/${post.data.slug}`} class="block h-full">
    <div class="h-48 overflow-hidden">
      <img
        src={post.data.image || '/images/placeholder-blog.jpg'}
        alt={post.data.title}
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
    <div class="p-6">
      <div class="flex items-center text-sm text-gray-500 mb-3">
        <span class="flex items-center mr-4">
          <Calendar class="w-4 h-4 mr-1" />
          {formatDate(post.data.pubDate)}
        </span>
        <span class="flex items-center">
          <Clock class="w-4 h-4 mr-1" />
          {getReadingTime(post.body)} min de lectura
        </span>
      </div>
      <h3 class="text-xl font-bold text-[hsl(var(--color-dark-green))] mb-2 hover:text-[hsl(var(--color-muted-green))] transition-colors">
        {post.data.title}
      </h3>
      <p class="text-gray-600 mb-4 line-clamp-2">
        {post.data.description}
      </p>
      <span class="inline-block text-[hsl(var(--color-muted-green))] font-medium hover:underline">
        Leer más →
      </span>
    </div>
  </a>
</article>