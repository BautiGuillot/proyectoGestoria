---
import { getCollection } from 'astro:content';
import BlogArticle from './ui/BlogArticle.astro';

// Get all blog posts and sort them by publication date
const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<section id="blog" class="py-24 px-4 bg-[hsl(var(--color-light-green))]/5">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div
      class="text-center mb-16 opacity-0 translate-y-8 animate-fade-in-up"
      data-anim="fade-in-up"
    >
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-6">
        Últimas Noticias
      </h2>
      <p class="text-lg text-[hsl(var(--color-dark-green))]/70 max-w-3xl mx-auto leading-relaxed">
        Mantente informado con nuestros artículos y noticias sobre legislación de tránsito y novedades legales.
      </p>
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPosts.map((post, index) => (
        <BlogArticle post={post} index={index} />
      ))}
    </div>

    <!-- View All Button -->
    <div class="text-center mt-12 opacity-0 translate-y-8 animate-fade-in-up" data-anim="fade-in-up">
      <a
        href="/blog"
        class="inline-block bg-[hsl(var(--color-muted-green))] text-white px-8 py-3 rounded-lg font-medium hover:bg-[hsl(var(--color-dark-green))] transition-colors"
      >
        Ver todas las publicaciones
      </a>
    </div>
  </div>
</section>

<style>
  .gradient-text {
    background: linear-gradient(90deg, #1a5f4a 0%, #2d8b6b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  
  /* Animation classes */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }
  
  /* Line clamp for excerpt */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>