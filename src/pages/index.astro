---
import AboutSectionV2 from '../components/AboutSectionV2.astro';
import HeroSection from '../components/HeroSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import ContactFormV2 from '../components/ContactFormV2.astro';
import BlogSection from '../components/BlogSection.astro';
import Layout from '../layouts/Layout.astro';

const DEFAULT_MULTAS_MSG = 'Hola, me estoy comunicando para reducir una multa';
const MULTAS_MSG = import.meta.env.WSP_MSG_MULTAS ?? DEFAULT_MULTAS_MSG;
const HOME_WSP_URL = "https://wa.me/5492364310487";
---

<Layout title="Inicio" multasMsg={MULTAS_MSG} wspUrl={HOME_WSP_URL}>

  <section id="HeroSection">
    <HeroSection wspUrl={HOME_WSP_URL} />
  </section>

  <section id="AboutSectionV2">
    <AboutSectionV2 />
  </section>

  <section id="HowItWorksSection">
    <HowItWorksSection />
  </section>

  <section id="ContactFormV2">
    <ContactFormV2 />
  </section>

  <section id="BlogSection">
    <BlogSection />
  </section>

</Layout>